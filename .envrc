use flake

# Warn when a newer release of rk or sdd is out. Each line reads the network
# at most once a week, or one hour after a failed read, and writes only its
# cache. The operator moves a pin from a shell, as the comments of flake.nix say.
rk self-depend check || true
sdd self-depend check || true

# Sync .venv from uv.lock with the host uv, and activate it.
layout uv

source_env_if_exists .envrc.local
