use flake

# Keep the pins of rk and sdd in flake.nix at their latest release. Each line
# tries at most one bump a day and leaves the diff for review.
rk self-depend sync --apply || true
sdd self-depend sync --apply || true

# Sync .venv from uv.lock with the host uv, and activate it.
layout uv

source_env_if_exists .envrc.local
