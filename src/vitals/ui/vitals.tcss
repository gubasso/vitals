/* The stylesheet of vitals. Every color is a token of the active theme, so the
   theme that the command palette picks recolors every panel. */

#overview {
    grid-size: 2 4;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto auto 1fr;
    grid-gutter: 0 1;
    padding: 0 1;
}

#processes {
    padding: 0 1;
}

#processes > .panel {
    width: 1fr;
    height: 1fr;
}

.panel {
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    overflow: hidden hidden;
}

/* Both panels of the first row take the height of the taller one, the GPU panel. */
#cpu, #gpu {
    height: 6;
}

#temperatures {
    column-span: 2;
    height: 1fr;
    min-height: 12;
}

#disks {
    column-span: 2;
}

.panel-error {
    display: none;
    color: $error;
}

.panel.-failed > .panel-error {
    display: block;
}

.panel.-failed > .panel-body {
    display: none;
}

.panel-body {
    height: auto;
}

TemperatureChart {
    height: 1fr;
}

.gauge {
    height: 1;
}

.gauge-label {
    width: 12;
    color: $text-muted;
}

.gauge ProgressBar {
    width: 1fr;
}

.gauge Bar {
    width: 1fr;
}

.gauge Bar > .bar--bar,
.gauge Bar > .bar--complete {
    color: $success;
}

.gauge.-warning Bar > .bar--bar {
    color: $warning;
}

.gauge.-critical Bar > .bar--bar {
    color: $error;
}

.gauge-value {
    width: 20;
    text-align: right;
}

.detail {
    color: $text-muted;
}
