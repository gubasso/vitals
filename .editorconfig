# EditorConfig for vitals. Each format has its owner: ruff (Python), nixfmt
# (Nix), dprint (Markdown). These lines keep editors in step with them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{nix,json,yaml,yml,toml,tcss}]
indent_style = space
indent_size = 2

[justfile]
indent_style = tab
